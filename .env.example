# Canonical origin. Used for canonical URLs, sitemap, robots and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://continuumpublications.org

# Optional. A form POST endpoint for the newsletter (Buttondown, Listmonk,
# MailerLite, Formspree, ConvertKit ... anything that accepts a plain form POST).
# If this is empty the newsletter UI falls back to an email link, which still works.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Optional. The name of the email field your newsletter provider expects.
# Buttondown uses "email", ConvertKit uses "email_address".
NEXT_PUBLIC_NEWSLETTER_FIELD=email
